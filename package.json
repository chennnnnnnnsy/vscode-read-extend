{
  "name": "STTO",
  "displayName": "STTO",
  "description": "Study Tool",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "readExtend.importBook",
        "title": "STTO: Import Book"
      },
      {
        "command": "readExtend.openBook",
        "title": "STTO: Open Book"
      },
      {
        "command": "readExtend.removeBook",
        "title": "STTO: Remove Book"
      },
      {
        "command": "readExtend.nextPage",
        "title": "STTO: Next Page"
      },
      {
        "command": "readExtend.prevPage",
        "title": "STTO: Previous Page"
      },
      {
        "command": "readExtend.toggleVisibility",
        "title": "STTO: Toggle Visibility"
      },
      {
        "command": "readExtend.goToChapter",
        "title": "STTO: Go to Chapter"
      },
      {
        "command": "readExtend.search",
        "title": "STTO: Search"
      },
      {
        "command": "readExtend.searchNext",
        "title": "STTO: Search Next"
      },
      {
        "command": "readExtend.searchPrev",
        "title": "STTO: Search Previous"
      }
    ],
    "configuration": {
      "title": "STTO",
      "properties": {
        "readExtend.displayLength": {
          "type": "number",
          "default": 50,
          "description": "Number of characters to display in the status bar"
        }
      }
    },
    "keybindings": [
      {
        "command": "readExtend.nextPage",
        "key": "alt+j",
        "mac": "alt+j"
      },
      {
        "command": "readExtend.prevPage",
        "key": "alt+k",
        "mac": "alt+k"
      },
      {
        "command": "readExtend.toggleVisibility",
        "key": "alt+h",
        "mac": "alt+h"
      },
      {
        "command": "readExtend.goToChapter",
        "key": "alt+c",
        "mac": "alt+c"
      },
      {
        "command": "readExtend.search",
        "key": "alt+s",
        "mac": "alt+s"
      },
      {
        "command": "readExtend.searchNext",
        "key": "alt+n",
        "mac": "alt+n"
      },
      {
        "command": "readExtend.searchPrev",
        "key": "alt+p",
        "mac": "alt+p"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "epub2": "^3.0.2"
  }
}
